# ==============================================================================
# EmberEye — Environment Configuration Template
# Copy to `.env` and customize as needed. Every variable has a safe default.
#   PowerShell:  Copy-Item .env.example .env
#   Bash:        cp .env.example .env
# ==============================================================================

# --- Database Storage ---------------------------------------------------------
# Docker Compose injects a PostgreSQL URL for the `db` service. For a local
# SQLite run, use: sqlite:///./embereye_dev.db
# The canonical variable is EMBEREBEYE_DATABASE_URL; EMBEREBEYE_DB_URL is an
# accepted alias (see backend/app/config.py).
POSTGRES_USER=embereye
POSTGRES_PASSWORD=embereye_dev_pw
POSTGRES_DB=embereye
EMBEREBEYE_DATABASE_URL=postgresql+psycopg://embereye:embereye_dev_pw@db:5432/embereye

# SQLite journal mode. Use DELETE when the file is bind-mounted from a Windows
# host into a container (see docker-compose.sqlite.yml).
EMBEREBEYE_SQLITE_JOURNAL=WAL

# --- Service Ports ------------------------------------------------------------
# For a public host behind Caddy/Nginx, bind app/API/DB to loopback so only the
# TLS reverse proxy is internet-facing:
#   BACKEND_PORT=127.0.0.1:8000
#   FRONTEND_PORT=127.0.0.1:8080
#   POSTGRES_PORT=127.0.0.1:5432
# Also replace POSTGRES_PASSWORD with a unique strong secret; never commit .env.
BACKEND_PORT=8000
FRONTEND_PORT=8080
POSTGRES_PORT=5432

# --- NASA FIRMS API Access (Optional) ----------------------------------------
# Obtain a free MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Without a key (or offline), EmberEye runs on its calibrated multi-era seed
# archive and labels the provenance honestly in the UI and /api/meta.
FIRMS_MAP_KEY=
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov
FIRMS_TIMEOUT_SECONDS=30
FIRMS_MAX_RETRIES=2

# --- Harmonization Pipeline & Seeding ---------------------------------------
# DATA_MODE options:
#   AUTO: use live FIRMS when a key and network are available, else seed.
#   SEED: force the deterministic calibrated archive (2000-2026).
#   LIVE: require live NASA FIRMS (fail loudly if unreachable).
DATA_MODE=AUTO
SEED_START=2000-11-02
SEED_END=2026-11-01
SEED_SCALE=1.0
SEED_VERSION=2026.10.1

# --- Scientific Climatology & Calibration -----------------------------------
# Baseline years used for Leave-One-Year-Out (LOYO) empirical 95th percentile
# anomalies; calibration window for the MODIS→VIIRS month-of-year transfer.
BASELINE_START=2012
BASELINE_END=2019
ANOMALY_Z_THRESHOLD=2.0
CALIBRATION_START=2012
CALIBRATION_END=2022

# --- Legacy seam settings (schema compatibility only) -----------------------
# The Phase 1 seam blending was retired in favour of month-of-year transfer
# factors. These remain configurable for backwards compatibility.
SEAM_START=2012-06-01
SEAM_END=2014-12-31

# --- Application Logging & CORS ---------------------------------------------
LOG_LEVEL=INFO
EMBEREBEYE_CORS_ORIGINS=*
