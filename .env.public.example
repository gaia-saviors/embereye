# Public launch template. Copy to .env, then fill both required values below.
# POSTGRES_PASSWORD must be a unique secret (for example: openssl rand -hex 32).
# PUBLIC_CORS_ORIGINS must be the exact HTTPS origin, e.g. https://fire.example.org.
# Keep this exact pin after v1.1.0 is published to GHCR.
EMBEREYE_IMAGE_TAG=v1.1.0
POSTGRES_USER=embereye
POSTGRES_PASSWORD=
POSTGRES_DB=embereye
PUBLIC_CORS_ORIGINS=
DATA_MODE=SEED
BACKEND_PORT=8000
FRONTEND_PORT=8080
POSTGRES_PORT=5432
FIRMS_MAP_KEY=
LOG_LEVEL=INFO
